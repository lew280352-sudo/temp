{
  "name": "stocklens",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:ui": "node test/browser.mjs",
    "test:users": "node test/virtual-users.mjs",
    "test:pwa": "node test/pwa.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs"
  },
  "devDependencies": {
    "playwright": "^1.58.2"
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2"
  }
}
