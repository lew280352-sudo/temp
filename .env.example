# Optional environment variables. Set these in your shell or use:
# node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=4173
# APP_ORIGIN=https://stocklens.example.com
# DATABASE_PATH=/absolute/path/to/persistent/stocklens.sqlite
# Public company RSS ingestion; no API key required.
NEWS_ENABLED=true
# Optional personal Finnhub key. Keep empty until you have a free account.
# Never put a key in dist/, GitHub or chat. Restart the server after editing .env.
FINNHUB_API_KEY=
# AI provider: auto uses Groq when GROQ_API_KEY exists, otherwise local Ollama.
AI_ENABLED=true
AI_PROVIDER=auto
# Free online AI. Create a key at https://console.groq.com/keys and keep it server-side.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Free local fallback. Install Ollama and pull the model before use.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
