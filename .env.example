# Optional environment variables. Set these in your shell or use:
# node --env-file=.env server.mjs
HOST=127.0.0.1
PORT=4173
# APP_ORIGIN=https://stocklens.example.com
# DATABASE_PATH=/absolute/path/to/persistent/stocklens.sqlite
# Public company RSS ingestion; no API key required.
NEWS_ENABLED=true
# Optional personal Finnhub key. Keep empty until you have a free account.
# Never put a key in dist/, GitHub or chat. Restart the server after editing .env.
FINNHUB_API_KEY=
# Optional free adjusted weekly prices for the chart and experimental 4-week trend/backtest.
# Obtain your own key at https://www.alphavantage.co/support/#api-key
# Do not put an API key in chat, dist/, or GitHub.
ALPHAVANTAGE_API_KEY=
# Encrypts authenticator (TOTP) seeds. Generate locally with: node scripts/configure-mfa.mjs
# Keep the same key across restarts and backups. Never share or commit it.
MFA_ENCRYPTION_KEY=
# Web Push works while the Node server is running. Generate locally with: node scripts/configure-push.mjs
# Keep the VAPID pair stable; the private key must not appear in Git or browser assets.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/lew280352-sudo/temp
# Optional SMTP for one-time email verification links. No emails are sent until configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# AI provider: auto uses Groq first and falls back to local Ollama; without a key it uses Ollama.
AI_ENABLED=true
AI_PROVIDER=auto
# Free online AI. Create a key at https://console.groq.com/keys and keep it server-side.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
# Free local fallback. Install Ollama and pull the model before use.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
